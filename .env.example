# EmailJS Configuration
# Get these credentials from your EmailJS dashboard: https://dashboard.emailjs.com/
#
# 1. Service ID: Dashboard -> Email Services (e.g., service_xxxxxxx)
# 2. Template ID: Dashboard -> Email Templates (e.g., template_xxxxxxx)
# 3. Public Key: Dashboard -> Account -> API Keys (e.g., user_xxxxxxx / xxxxxxx)

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
